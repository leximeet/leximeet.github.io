{
  "name": "leximeet-documentation",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22.12.0 <26"
  },
  "scripts": {
    "prepare:docs": "node scripts/prepare-docs.mjs",
    "dev": "npm run prepare:docs && vitepress dev website --host 127.0.0.1",
    "build": "npm run prepare:docs && vitepress build website",
    "serve": "npm run prepare:docs && vite preview website --outDir .vitepress/dist --host 127.0.0.1",
    "test": "node --test scripts/*.test.mjs",
    "test:ui": "playwright test",
    "verify:docs": "node scripts/verify-docs.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run test && npm run verify:docs && npm run format:check && npm run build",
    "test:dev": "node scripts/test-dev.mjs",
    "render:diagrams": "node scripts/render-doc-diagrams.mjs",
    "check:diagrams": "node scripts/check-doc-diagrams.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "mermaid": "11.17.2",
    "prettier": "3.6.2",
    "vitepress": "1.6.4"
  },
  "overrides": {
    "vite": "6.4.3"
  }
}
